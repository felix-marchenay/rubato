# Configuration de l'envoi d'APK sur Telegram (make telegram / make apk-telegram).
# Copie ce fichier vers .env  ->  cp .env.example .env  puis remplis les valeurs.
# .env est git-ignoré : tes secrets ne partent jamais dans le dépôt.

# Token du bot, fourni par @BotFather sur Telegram.
TELEGRAM_BOT_TOKEN=123456789:AA-remplace-moi

# Id de la conversation où recevoir l'APK.
# Pour le trouver : écris un message à ton bot, puis ouvre
#   https://api.telegram.org/bot<TON_TOKEN>/getUpdates
# et lis "chat":{"id": ...}.
TELEGRAM_CHAT_ID=123456789
